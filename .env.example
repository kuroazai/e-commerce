# Copy to .env and fill in. .env is gitignored and must stay that way.
# Every value here is a placeholder. Nothing in this file is a real endpoint,
# key or mailbox.

# --- core ------------------------------------------------------------------
CARDSHOP_ENV=development
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=cardshop

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=60

# --- price sources ---------------------------------------------------------
# Both marketplaces have official APIs and both forbid scraping their listing
# pages. Leave blank to run on a static price file instead; the provider is then
# simply absent from the price summary.
# eBay: https://developer.ebay.com  (Browse API, EBAY_GB marketplace)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_GB

# Cardmarket: https://api.cardmarket.com  (OAuth1, app token + secret)
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=

# Cardmarket settles in euros; inventory is costed in pounds. Static rate on
# purpose - a live FX lookup is another network dependency and another failure
# mode for something that moves a couple of percent a month. Set it exactly if
# you need the figures for accounting.
CARDSHOP_EUR_GBP=0.85

# --- sale notification mailbox --------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Replay .eml files from a folder instead of connecting to IMAP. Use this to
# develop a parser against real emails without touching the live mailbox.
CARDSHOP_MAILDIR=

# --- LLM escalation (optional) --------------------------------------------
# Used ONLY where deterministic code has run out: an email no parser recognises,
# or a listing title that matches two inventory items too closely to separate.
# Leave blank and the pipeline runs fully deterministic, reporting what it would
# have escalated. That is a supported mode, not a degraded one.
#
# Anything OpenAI-compatible works - a local server or a hosted provider.
CARDSHOP_MODEL_ID=
CARDSHOP_MODEL_API_BASE=
CARDSHOP_MODEL_API_KEY=
# Ceiling on escalations per run, so a mailbox full of junk cannot quietly
# spend money.
CARDSHOP_MAX_ESCALATIONS=10

# --- notifications ---------------------------------------------------------
# Slack / Discord / ntfy webhook. Blank prints to the console.
CARDSHOP_NOTIFY_WEBHOOK=
